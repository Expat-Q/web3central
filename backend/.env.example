# ============================================
# Web3Central Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# ============================================
# REQUIRED - App will not start without these
# ============================================

# MongoDB connection string
# Local: mongodb://localhost:27017/web3central
# Atlas: mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE
MONGODB_URI=

# JWT secret for signing tokens (minimum 32 characters recommended)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ============================================
# SERVER CONFIGURATION
# ============================================

# Port for the backend server
PORT=5000

# Environment mode (development | production)
NODE_ENV=development

# Token expiration (e.g., 30d, 7d, 24h)
JWT_EXPIRE=30d

# Cookie expiration in days
JWT_COOKIE_EXPIRE=30

# Allowed frontend origins (comma-separated for multiple)
# Dev: http://localhost:3000
# Prod: https://web3central.vercel.app
FRONTEND_URL=http://localhost:3000

# Session secret for OAuth (auto-generated if not set)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ============================================
# OBSERVABILITY & LOGGING
# ============================================

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Service name for structured logs
SERVICE_NAME=web3central-backend

# ============================================
# OAUTH PROVIDERS (Optional)
# ============================================

# Google OAuth - https://console.developers.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth - https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Twitter OAuth - https://developer.twitter.com/
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=

# ============================================
# AI SERVICES (Optional)
# ============================================
GEMINI_API_KEY=
GROK_API_KEY=

# ============================================
# EMAIL NOTIFICATIONS (Optional)
# ============================================

# Gmail SMTP - Use app-specific password
# https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=

# Admin email for notifications
ADMIN_EMAIL=

# ============================================
# DEVELOPER CONSOLE & VAULT
# ============================================
# The vault address for receiving dApp listing fees (0.001 ETH)
W3C_VAULT_ADDRESS=0x3C80818c4ebA036D54775Bd0D8994d3dfc0b7A25

