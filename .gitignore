*.tmp
*.log
eslint_out.txt
build_out.txt
*.out.txt

# ── Debug logs ────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ── Test & coverage ───────────────────────────────────────────────────────────
*.test.js
*.test.ts
*.spec.js
*.spec.ts
test-*.js
backend/test-*.js
coverage/
Coverage/
.nyc_output/

